// The same repair, with Claude as the editor.
//
// Running this calls the Anthropic API and costs money. It needs the 'anthropic' extra and
// credentials in the environment (ANTHROPIC_API_KEY or an 'ant auth login' profile). Every
// exchange is written to <out>/transcripts/, and `weightsmith run --replay <out>/transcripts`
// repeats the run exactly without calling the API.

model LM = load("fixtures/tiny_llama_defective")

behavior count_train    = probes("fixtures/tiny_llama/count_train.json",    metric = accuracy)
behavior opposite_train = probes("fixtures/tiny_llama/opposite_train.json", metric = accuracy)
behavior first_train    = probes("fixtures/tiny_llama/first_train.json",    metric = accuracy)
behavior count_test     = probes("fixtures/tiny_llama/count_test.json",     metric = accuracy)
behavior opposite_test  = probes("fixtures/tiny_llama/opposite_test.json",  metric = accuracy)
behavior first_test     = probes("fixtures/tiny_llama/first_test.json",     metric = accuracy)

editor Claude = provider("anthropic", model = "claude-opus-5-5", effort = "high")

program RepairWithClaude {
    target LM

    policy {
        allow probe(max_forward_passes = 2000)
        allow mutate(max_changed_params = 1%)
        allow reason(max_calls = 30, max_tokens = 2000000)
        allow execute(max_seconds = 300)
        allow save
        forbid train
    }

    contract {
        improve  count_test    (min_delta = 0.1)
        preserve opposite_test (tolerance = 0.07, min_n = 16)
        preserve first_test    (tolerance = 0.02)
        require  finite
    }

    delegate Claude (
        task = "One of this model's three tasks is broken. Find out which, find the cause in the weights, and fix it without training and without harming the other tasks.",
        tools = [describe, read_weights, stats, find, run_probes, forward, edit, set_weights, undo, python],
        practice = [count_train, opposite_train, first_train],
        max_steps = 30
    )
    verify

    output { model, patch, evaluation }
}
