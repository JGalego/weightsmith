{
  "name": "weightsmith",
  "displayName": "Weightsmith",
  "description": "Syntax highlighting and hover documentation for Weightsmith (.wsm) programs.",
  "version": "0.1.0",
  "publisher": "jgalego",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/weightsmith",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:weightsmith"
  ],
  "contributes": {
    "languages": [
      {
        "id": "weightsmith",
        "aliases": [
          "Weightsmith",
          "wsm"
        ],
        "extensions": [
          ".wsm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "weightsmith",
        "scopeName": "source.weightsmith",
        "path": "./syntaxes/weightsmith.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Weightsmith",
      "properties": {
        "weightsmith.server.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that runs Weightsmith, for example `[\"uv\", \"run\", \"weightsmith\"]`; `lsp` is appended. Empty: the workspace's `.venv`, else `weightsmith` on the PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
